[Unit]
Description=pve-secrets: VRRP address for OpenBao (own keepalived instance)
After=network-online.target openbao.service
ConditionPathExists=/etc/pve-secrets/keepalived.conf

[Service]
Type=simple
RuntimeDirectory=pve-secrets
ExecStart=/usr/sbin/keepalived --dont-fork --log-console --vrrp \
    -f /etc/pve-secrets/keepalived.conf -p /run/pve-secrets/keepalived.pid \
    -r /run/pve-secrets/vrrp.pid
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure

[Install]
WantedBy=multi-user.target
