#!/bin/sh
# Store data (/var/lib/openbao) and cluster settings (/etc/pve/secrets.cfg,
# /etc/pve/priv/pve-secrets) are kept on purge: deleting them destroys every
# secret. See README "Uninstall".
set -e
if [ "$1" = purge ]; then
    rm -f /etc/pve-secrets/keepalived.conf
    rmdir /etc/pve-secrets 2>/dev/null || true
fi
systemctl daemon-reload >/dev/null 2>&1 || true
