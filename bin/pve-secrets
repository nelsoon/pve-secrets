#!/usr/bin/perl
# pve-secrets: run an HA OpenBao store on the nodes of a Proxmox VE cluster.
#
#   pve-secrets init --vip IP/CIDR [--name DNS] [--interface IF] [--vrid N]
#   pve-secrets converge      (systemd timer, every node)
#   pve-secrets status
#
# SPDX-License-Identifier: AGPL-3.0-or-later
use strict;
use warnings;

use Digest::SHA qw(sha256_hex);
use File::Path qw(make_path);
use File::Temp qw(tempdir);
use Getopt::Long qw(GetOptionsFromArray);
use JSON::PP;
use PVE::Cluster;
use PVE::INotify;

my $CFG      = '/etc/pve/secrets.cfg';
my $PRIV     = '/etc/pve/priv/pve-secrets';
my $SEAL     = "$PRIV/seal.key";
my $ADMIN    = "$PRIV/admin.token";
my $CA       = '/etc/pve/pve-root-ca.pem';
my $CA_KEY   = '/etc/pve/priv/pve-root-ca.key';
my $ETC      = '/etc/openbao';
my $HCL      = "$ETC/openbao.hcl";
my $TLS      = "$ETC/tls";
my $RAFT     = '/var/lib/openbao/raft';
my $AUDIT    = '/var/log/openbao';
my $KA       = '/etc/pve-secrets/keepalived.conf';
my $AUD_FILE = '/etc/pve/identity/audiences.d/openbao.json';
my $MAX_VOTERS = 5;
my $PORT     = 8200;

my $json = JSON::PP->new->canonical->pretty;

sub logmsg { print STDERR "pve-secrets: @_\n" }
sub fail   { logmsg(@_); exit 1 }

sub read_file {
    my ($f) = @_;
    open(my $fh, '<', $f) or return undef;
    local $/;
    my $d = <$fh>;
    close $fh;
    return $d;
}

# Write atomically; return 1 when the content changed.
sub write_if_changed {
    my ($f, $data, $mode, $owner) = @_;
    my $old = read_file($f);
    return 0 if defined $old && $old eq $data;
    my $tmp = "$f.tmp.$$";
    open(my $fh, '>', $tmp) or die "write $tmp: $!\n";
    print $fh $data;
    close $fh or die "close $tmp: $!\n";
    chmod($mode // 0644, $tmp);
    if ($owner) {
        my (undef, undef, $uid, $gid) = getpwnam($owner);
        chown($uid, $gid, $tmp) if defined $uid;
    }
    rename($tmp, $f) or die "rename $f: $!\n";
    return 1;
}

sub run {
    my (@cmd) = @_;
    my $pid = open(my $fh, '-|') // die "fork: $!\n";
    if (!$pid) {
        open(STDERR, '>&', \*STDOUT);
        exec { $cmd[0] } @cmd or exit 127;
    }
    local $/;
    my $out = <$fh> // '';
    close $fh;
    return wantarray ? ($? >> 8, $out) : $? >> 8;
}

sub load_cfg {
    my $raw = read_file($CFG) // return undef;
    my %c = (interface => 'vmbr0', vrid => 90);
    for (split /\n/, $raw) {
        next if /^\s*(#|$)/;
        $c{$1} = $2 if /^\s*(\w+)\s*:\s*(\S+)\s*$/;
    }
    return \%c;
}

sub members {
    PVE::Cluster::cfs_update();
    my $m = PVE::Cluster::get_members() // {};
    my $self = PVE::INotify::nodename();
    if (!%$m) {    # single node, not clustered
        my $ip = PVE::Cluster::remote_node_ip($self);
        $m = { $self => { ip => $ip } };
    }
    my @n = map { { name => $_, ip => $m->{$_}{ip} } } sort keys %$m;
    return ($self, \@n);
}

# ---------------------------------------------------------------- TLS

sub cert_ok {
    my ($crt, $sans) = @_;
    return 0 if !-f $crt;
    return 0 if run('openssl', 'x509', '-in', $crt, '-noout', '-checkend', 30 * 86400);
    my (undef, $txt) = run('openssl', 'x509', '-in', $crt, '-noout', '-ext', 'subjectAltName');
    for my $s (@$sans) {
        my $want = $s =~ /^[\d.]+$/ ? "IP Address:$s" : "DNS:$s";
        return 0 if index($txt, $want) < 0;
    }
    return 1;
}

# Node certificate from the PVE cluster CA. Returns 1 when (re)issued.
sub ensure_cert {
    my ($sans) = @_;
    my $crt = "$TLS/node.pem";
    return 0 if cert_ok($crt, $sans);
    make_path($TLS, { mode => 0750 });
    my $d = tempdir(CLEANUP => 1);
    my $san = join(',', map { /^[\d.]+$/ ? "IP:$_" : "DNS:$_" } @$sans);
    write_if_changed("$d/ext", "basicConstraints=critical,CA:FALSE\n"
        . "keyUsage=critical,digitalSignature,keyEncipherment\n"
        . "extendedKeyUsage=serverAuth,clientAuth\nsubjectAltName=$san\n");
    my (undef, $rnd) = run('openssl', 'rand', '-hex', '16');
    chomp $rnd;
    my ($rc, $out) = run('openssl', 'req', '-new', '-newkey', 'ec', '-pkeyopt',
        'ec_paramgen_curve:P-256', '-nodes', '-keyout', "$d/key", '-subj',
        "/O=pve-secrets/CN=$sans->[0]", '-out', "$d/csr");
    die "csr: $out" if $rc;
    ($rc, $out) = run('openssl', 'x509', '-req', '-in', "$d/csr", '-CA', $CA,
        '-CAkey', $CA_KEY, '-set_serial', '0x7' . substr($rnd, 1), '-days', 730,
        '-sha256', '-extfile', "$d/ext", '-out', "$d/crt");
    die "sign: $out" if $rc;
    write_if_changed("$TLS/node.key", read_file("$d/key"), 0640, 'openbao');
    write_if_changed($crt, read_file("$d/crt"), 0644, 'openbao');
    my (undef, undef, undef, $gid) = getpwnam('openbao');
    chown(0, $gid, $TLS) if defined $gid;
    logmsg("issued node certificate (@$sans)");
    return 1;
}

# ---------------------------------------------------------------- config

sub hcl {
    my ($self, $nodes, $cfg) = @_;
    my ($me) = grep { $_->{name} eq $self } @$nodes;
    my $ip = $me->{ip};
    # The first MAX_VOTERS nodes (by name) auto-join as voters. Further
    # nodes are not auto-joined yet (non-voter join is a v0.2 item).
    my @voters = grep { defined } @$nodes[0 .. $MAX_VOTERS - 1];
    my $join = '';
    for my $n (@voters) {
        next if $n->{name} eq $self;
        $join .= "  retry_join {\n    leader_api_addr = \"https://$n->{ip}:$PORT\"\n"
            . "    leader_ca_cert_file = \"$TLS/ca.pem\"\n  }\n";
    }
    my $base = <<"EOF";
# Managed by pve-secrets converge; local edits are overwritten.
ui = true
api_addr = "https://$ip:$PORT"
cluster_addr = "https://$ip:@{[ $PORT + 1 ]}"
disable_mlock = true

listener "tcp" {
  address = "0.0.0.0:$PORT"
  cluster_address = "0.0.0.0:@{[ $PORT + 1 ]}"
  tls_cert_file = "$TLS/node.pem"
  tls_key_file = "$TLS/node.key"
}

seal "static" {
  current_key_id = "pve-1"
  current_key = "file:///run/credentials/openbao.service/seal.key"
}

audit "file" "file" {
  options {
    file_path = "$AUDIT/audit.log"
    mode = "0600"
  }
}
EOF
    my $storage = "\nstorage \"raft\" {\n  path = \"$RAFT\"\n  node_id = \"$self\"\n"
        . "JOIN}\n";
    my $stable = $base . $storage;
    (my $full = $stable) =~ s/JOIN/$join/;
    $stable =~ s/JOIN//;
    return ($full, sha256_hex($stable));
}

sub keepalived_conf {
    my ($cfg, $self) = @_;
    my $pass = substr(sha256_hex(read_file($SEAL) // ''), 0, 8);
    return <<"EOF";
# Managed by pve-secrets converge.
global_defs {
    router_id pve_secrets_$self
    enable_script_security
    script_user root
}
vrrp_script chk_openbao {
    script "/usr/lib/pve-secrets/health"
    interval 2
    fall 2
    rise 2
}
vrrp_instance VI_PVE_SECRETS {
    state BACKUP
    interface $cfg->{interface}
    virtual_router_id $cfg->{vrid}
    priority 100
    advert_int 1
    authentication {
        auth_type PASS
        auth_pass $pass
    }
    virtual_ipaddress {
        $cfg->{vip}
    }
    track_script {
        chk_openbao
    }
}
EOF
}

sub systemctl { run('systemctl', @_) }

sub converge {
    my $cfg = load_cfg() // return 0;    # not initialised: nothing to do
    fail("missing $SEAL") if !-f $SEAL;
    my ($self, $nodes) = members();
    my ($me) = grep { $_->{name} eq $self } @$nodes;
    fail("no IP for node $self") if !$me || !$me->{ip};
    (my $vip = $cfg->{vip}) =~ s{/.*}{};

    for my $d ($ETC, $RAFT, $AUDIT) { make_path($d) if !-d $d }
    my (undef, undef, $uid, $gid) = getpwnam('openbao');
    fail('user openbao missing (install openbao)') if !defined $uid;
    chown($uid, $gid, $RAFT, $AUDIT);
    chmod(0700, $RAFT, $AUDIT);

    my @sans = ($self, $me->{ip}, $vip, '127.0.0.1');
    push @sans, $cfg->{name} if $cfg->{name};
    my $cert = ensure_cert(\@sans);
    # openbao cannot read /etc/pve: keep a copy of the cluster CA.
    write_if_changed("$TLS/ca.pem", read_file($CA), 0644, 'openbao');

    my ($text, $hash) = hcl($self, $nodes, $cfg);
    my $hfile = "$ETC/.pve-secrets.hash";
    my $restart = (read_file($hfile) // '') ne $hash;
    write_if_changed($HCL, $text, 0640, 'openbao');
    my (undef, undef, undef, $g) = getpwnam('openbao');
    chown(0, $g, $HCL);
    write_if_changed($hfile, $hash, 0600);

    if (systemctl('is-enabled', '--quiet', 'openbao')) {
        systemctl('enable', '--quiet', 'openbao');
    }
    if (systemctl('is-active', '--quiet', 'openbao')) {
        logmsg('starting openbao');
        systemctl('reset-failed', 'openbao');
        systemctl('start', 'openbao');
    } elsif ($restart) {
        logmsg('config changed, restarting openbao');
        systemctl('restart', 'openbao');
    } elsif ($cert) {
        systemctl('reload', 'openbao');
    }

    make_path('/etc/pve-secrets');
    if (write_if_changed($KA, keepalived_conf($cfg, $self), 0600)) {
        logmsg('keepalived config updated');
        systemctl('enable', '--quiet', 'pve-secrets-vip');
        systemctl('restart', 'pve-secrets-vip');
    } elsif (systemctl('is-active', '--quiet', 'pve-secrets-vip')) {
        systemctl('enable', '--quiet', 'pve-secrets-vip');
        systemctl('start', 'pve-secrets-vip');
    }

    # Relying-party registration in pve-identity (if installed).
    if (-d '/etc/pve/identity/audiences.d' && !-f $AUD_FILE) {
        write_if_changed($AUD_FILE,
            $json->encode({ audience => 'openbao', product => 'pve-secrets' }));
    }

    renew_admin_token();
    return 0;
}

# ---------------------------------------------------------------- API

sub api {
    my ($method, $path, $body, $token) = @_;
    $token //= do { my $t = read_file($ADMIN); chomp $t if defined $t; $t };
    my @cmd = ('curl', '-sS', '--cacert', $CA, '-X', $method, '-w', '\n%{http_code}',
        "https://127.0.0.1:$PORT/v1/$path");
    push @cmd, '-H', "X-Vault-Token: $token" if $token;
    push @cmd, '-H', 'Content-Type: application/json', '--data-binary',
        encode_json($body) if $body;
    my (undef, $out) = run(@cmd);
    my ($data, $code) = $out =~ /\A(.*)\n(\d+)\z/s ? ($1, $2) : ($out, 0);
    my $d = eval { decode_json($data) } // { raw => $data };
    return ($code, $d);
}

sub renew_admin_token {
    return if !-f $ADMIN;
    my ($c, $d) = api('GET', 'auth/token/lookup-self');
    return if $c != 200;
    my $ttl = $d->{data}{ttl} // 0;
    api('POST', 'auth/token/renew-self', {}) if $ttl < 12 * 3600;
}

sub wait_up {
    for (1 .. 60) {
        my ($c) = api('GET', 'sys/health?uninitcode=200&sealedcode=200&standbyok=true', undef, '');
        return 1 if $c == 200;
        sleep 1;
    }
    return 0;
}

sub cmd_init {
    my @a = @_;
    my %o = (interface => 'vmbr0', vrid => 90);
    GetOptionsFromArray(\@a, \%o, 'vip=s', 'name=s', 'interface=s', 'vrid=i', 'json')
        or fail('bad options');
    fail('--vip IP/CIDR is required') if !$o{vip} || $o{vip} !~ m{^[\d.]+/\d+$};
    fail("already initialised ($CFG exists)") if -f $CFG;
    make_path($PRIV, { mode => 0700 });
    if (!-f $SEAL) {
        my ($rc, $out) = run('openssl', 'rand', '-out', $SEAL, 32);
        fail("seal key: $out") if $rc;
    }
    fail("--interface: no such interface $o{interface}") if !-d "/sys/class/net/$o{interface}";
    my $txt = "# pve-secrets cluster settings\n"
        . join('', map { "$_: $o{$_}\n" } grep { defined $o{$_} } qw(vip name interface vrid));
    write_if_changed($CFG, $txt);
    converge();
    wait_up() or fail('openbao did not come up');

    my ($c, $d) = api('PUT', 'sys/init', { recovery_shares => 5, recovery_threshold => 3 }, '');
    fail("init failed ($c): " . encode_json($d)) if $c != 200;
    my $root = $d->{root_token};
    my $keys = $d->{recovery_keys_base64} // [];
    if (@$keys != 5) {    # never lose the keys: keep the raw answer
        write_if_changed('/root/pve-secrets-init.json', encode_json($d), 0600);
        fail('unexpected init answer saved to /root/pve-secrets-init.json');
    }
    sleep 2;
    api('PUT', 'sys/policies/acl/pve-admin',
        { policy => qq{path "*" { capabilities = ["create","read","update","delete","list","sudo"] }\n} },
        $root);
    my ($tc, $td) = api('POST', 'auth/token/create-orphan',
        { policies => ['pve-admin'], period => '72h', display_name => 'pve-secrets-admin',
          no_default_policy => JSON::PP::true }, $root);
    fail("admin token ($tc)") if $tc != 200;
    write_if_changed($ADMIN, $td->{auth}{client_token} . "\n", 0600);
    api('PUT', 'sys/raft/autopilot/configuration', { cleanup_dead_servers => JSON::PP::false });
    api('POST', 'auth/token/revoke-self', {}, $root);

    if ($o{json}) {    # API: keys go back to the caller only
        print encode_json({ recovery_keys => $keys, threshold => 3 }), "\n";
        return 0;
    }
    print "pve-secrets initialised. Store these recovery keys OFFLINE now;\n"
        . "they are not saved anywhere (any 3 of 5 regenerate a root token):\n\n";
    print "  $_\n" for @$keys;
    print "\nThe other nodes join within a minute (pve-secrets-converge.timer).\n";
    return 0;
}

sub status_data {
    my $cfg = load_cfg() // return { initialised => JSON::PP::false };
    my ($c, $h) = api('GET', 'sys/health?standbyok=true&sealedcode=200&uninitcode=200', undef, '');
    my $local = $c == 0 ? 'down'
        : $h->{sealed} ? 'sealed' : $h->{standby} ? 'standby' : 'active';
    my ($ac, $ap) = api('GET', 'sys/storage/raft/autopilot/state');
    my $s = $ac == 200 ? ($ap->{data} // $ap) : {};
    my @servers = map {
        my $v = $s->{servers}{$_};
        { node => $_, status => $v->{status}, voter => ($v->{node_type} // '') eq 'voter' ? 1 : 0,
          healthy => $v->{healthy} ? 1 : 0, address => $v->{address} }
    } sort keys %{ $s->{servers} // {} };
    return {
        initialised => JSON::PP::true, vip => $cfg->{vip}, name => $cfg->{name},
        local => $local, version => $h->{version},
        available => $ac == 200 ? 1 : 0, healthy => $s->{healthy} ? 1 : 0,
        leader => $s->{leader}, failure_tolerance => $s->{failure_tolerance} // 0,
        servers => \@servers,
    };
}

sub cmd_status {
    if (grep { $_ eq '--json' } @_) {
        print encode_json(status_data()), "\n";
        return 0;
    }
    my $cfg = load_cfg();
    if (!$cfg) { print "not initialised\n"; return 0 }
    my ($c, $h) = api('GET', 'sys/health?standbyok=true&sealedcode=200&uninitcode=200', undef, '');
    printf "local: %s\n", $c == 0 ? 'down'
        : ($h->{sealed} ? 'sealed' : $h->{standby} ? 'standby' : 'active') . " ($h->{version})";
    my ($ac, $ap) = api('GET', 'sys/storage/raft/autopilot/state');
    if ($ac != 200) { print "cluster: unavailable ($ac)\n"; return 1 }
    my $s = $ap->{data} // $ap;
    my $tol = $s->{failure_tolerance} // 0;
    printf "cluster: %s, leader %s, failure tolerance %d%s\n",
        $s->{healthy} ? 'healthy' : 'UNHEALTHY', $s->{leader} // '?', $tol,
        $tol == 0 ? '  WARNING: losing any node stops the store' : '';
    for my $id (sort keys %{ $s->{servers} // {} }) {
        my $v = $s->{servers}{$id};
        printf "  %-12s %-9s %-8s %s\n", $id, $v->{status}, $v->{node_type} // '',
            $v->{healthy} ? 'healthy' : 'unhealthy';
    }
    printf "vip: %s\n", $cfg->{vip};
    return $s->{healthy} ? 0 : 1;
}

my $cmd = shift @ARGV // 'help';
exit(
      $cmd eq 'init'     ? cmd_init(@ARGV)
    : $cmd eq 'converge' ? converge()
    : $cmd eq 'status'   ? cmd_status(@ARGV)
    : do { print "usage: pve-secrets init --vip IP/CIDR [--name DNS] | converge | status\n"; $cmd eq 'help' ? 0 : 1 }
);
