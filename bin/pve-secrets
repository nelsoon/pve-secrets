#!/usr/bin/perl
# pve-secrets: run an HA OpenBao store on the nodes of a Proxmox VE cluster.
#
#   pve-secrets init --vip IP/CIDR [--name DNS] [--interface IF] [--vrid N]
#   pve-secrets converge      (systemd timer, every node)
#   pve-secrets status [--json]
#   pve-secrets backup-config --storage ID [--keep N] [--interval HOURS]
#   pve-secrets backup [--force]      (hourly timer; only the active node acts)
#   pve-secrets backup-check [--json]
#   pve-secrets export-seal-key
#   pve-secrets restore SNAPSHOT [--seal-key FILE --vip IP/CIDR ...]  (recovery keys on stdin)
#   pve-secrets recover-admin                                        (recovery keys on stdin)
#   pve-secrets k8s-register --cluster NAME --issuer URL --jwks FILE   (JWKS JSON or PEM keys)
#   pve-secrets k8s-unregister --cluster NAME | k8s-list [--json]
#
# SPDX-License-Identifier: AGPL-3.0-or-later
use strict;
use warnings;

use Digest::SHA qw(sha256_hex);
use MIME::Base64 qw(encode_base64 decode_base64);
use File::Path qw(make_path);
use File::Temp qw(tempdir);
use Getopt::Long qw(GetOptionsFromArray);
use JSON::PP;
use PVE::Cluster;
use PVE::INotify;

my $CFG      = '/etc/pve/secrets.cfg';
my $PRIV     = '/etc/pve/priv/pve-secrets';
my $SEAL     = "$PRIV/seal.key";
my $ADMIN    = "$PRIV/admin.token";
my $RESTORING = "$PRIV/restoring";    # node name doing a rebuilt-cluster restore
my $CA       = '/etc/pve/pve-root-ca.pem';
my $CA_KEY   = '/etc/pve/priv/pve-root-ca.key';
my $ETC      = '/etc/openbao';
my $HCL      = "$ETC/openbao.hcl";
my $TLS      = "$ETC/tls";
my $RAFT     = '/var/lib/openbao/raft';
my $AUDIT    = '/var/log/openbao';
my $KA       = '/etc/pve-secrets/keepalived.conf';
my $AUD_FILE = '/etc/pve/identity/audiences.d/openbao.json';
my $ISSUER   = '/etc/pve/identity/issuers.d/pve.json';
my $K8S_DIR  = '/etc/pve/secrets.d/k8s';    # <cluster>.json: issuer + public keys
my $MAX_VOTERS = 5;
my $PORT     = 8200;
my @CFG_KEYS = qw(vip name interface vrid backup_storage backup_keep backup_interval);

my $json = JSON::PP->new->canonical->pretty;

sub logmsg { print STDERR "pve-secrets: @_\n" }
sub fail   { logmsg(@_); exit 1 }

sub read_file {
    my ($f) = @_;
    open(my $fh, '<', $f) or return undef;
    local $/;
    my $d = <$fh>;
    close $fh;
    return $d;
}

# Write atomically; return 1 when the content changed.
sub write_if_changed {
    my ($f, $data, $mode, $owner) = @_;
    my $old = read_file($f);
    return 0 if defined $old && $old eq $data;
    my $tmp = "$f.tmp.$$";
    open(my $fh, '>', $tmp) or die "write $tmp: $!\n";
    print $fh $data;
    close $fh or die "close $tmp: $!\n";
    chmod($mode // 0644, $tmp);
    if ($owner) {
        my (undef, undef, $uid, $gid) = getpwnam($owner);
        chown($uid, $gid, $tmp) if defined $uid;
    }
    rename($tmp, $f) or die "rename $f: $!\n";
    return 1;
}

sub run {
    my (@cmd) = @_;
    my $pid = open(my $fh, '-|') // die "fork: $!\n";
    if (!$pid) {
        open(STDERR, '>&', \*STDOUT);
        exec { $cmd[0] } @cmd or exit 127;
    }
    local $/;
    my $out = <$fh> // '';
    close $fh;
    return wantarray ? ($? >> 8, $out) : $? >> 8;
}

sub load_cfg {
    my $raw = read_file($CFG) // return undef;
    my %c = (interface => 'vmbr0', vrid => 90);
    for (split /\n/, $raw) {
        next if /^\s*(#|$)/;
        $c{$1} = $2 if /^\s*(\w+)\s*:\s*(\S+)\s*$/;
    }
    # a damaged file must stop converge rather than reconfigure the VIP
    fail("$CFG: no valid 'vip' line") if ($c{vip} // '') !~ m{^[\d.]+/\d+$};
    return \%c;
}

sub members {
    PVE::Cluster::cfs_update();
    my $m = PVE::Cluster::get_members() // {};
    my $self = PVE::INotify::nodename();
    if (!%$m) {    # single node, not clustered
        my $ip = PVE::Cluster::remote_node_ip($self);
        $m = { $self => { ip => $ip } };
    }
    my @n = map { { name => $_, ip => $m->{$_}{ip} } } sort keys %$m;
    return ($self, \@n);
}

# ---------------------------------------------------------------- TLS

sub cert_ok {
    my ($crt, $sans) = @_;
    return 0 if !-f $crt;
    return 0 if run('openssl', 'x509', '-in', $crt, '-noout', '-checkend', 30 * 86400);
    my (undef, $txt) = run('openssl', 'x509', '-in', $crt, '-noout', '-ext', 'subjectAltName');
    for my $s (@$sans) {
        my $want = $s =~ /^[\d.]+$/ ? "IP Address:$s" : "DNS:$s";
        return 0 if index($txt, $want) < 0;
    }
    return 1;
}

# Node certificate from the PVE cluster CA. Returns 1 when (re)issued.
sub ensure_cert {
    my ($sans) = @_;
    my $crt = "$TLS/node.pem";
    return 0 if cert_ok($crt, $sans);
    make_path($TLS, { mode => 0750 });
    my $d = tempdir(CLEANUP => 1);
    my $san = join(',', map { /^[\d.]+$/ ? "IP:$_" : "DNS:$_" } @$sans);
    write_if_changed("$d/ext", "basicConstraints=critical,CA:FALSE\n"
        . "keyUsage=critical,digitalSignature,keyEncipherment\n"
        . "extendedKeyUsage=serverAuth,clientAuth\nsubjectAltName=$san\n");
    my (undef, $rnd) = run('openssl', 'rand', '-hex', '16');
    chomp $rnd;
    my ($rc, $out) = run('openssl', 'req', '-new', '-newkey', 'ec', '-pkeyopt',
        'ec_paramgen_curve:P-256', '-nodes', '-keyout', "$d/key", '-subj',
        "/O=pve-secrets/CN=$sans->[0]", '-out', "$d/csr");
    die "csr: $out" if $rc;
    ($rc, $out) = run('openssl', 'x509', '-req', '-in', "$d/csr", '-CA', $CA,
        '-CAkey', $CA_KEY, '-set_serial', '0x7' . substr($rnd, 1), '-days', 730,
        '-sha256', '-extfile', "$d/ext", '-out', "$d/crt");
    die "sign: $out" if $rc;
    write_if_changed("$TLS/node.key", read_file("$d/key"), 0640, 'openbao');
    write_if_changed($crt, read_file("$d/crt"), 0644, 'openbao');
    my (undef, undef, undef, $gid) = getpwnam('openbao');
    chown(0, $gid, $TLS) if defined $gid;
    logmsg("issued node certificate (@$sans)");
    return 1;
}

# ---------------------------------------------------------------- config

sub hcl {
    my ($self, $nodes, $cfg) = @_;
    my ($me) = grep { $_->{name} eq $self } @$nodes;
    my $ip = $me->{ip};
    # The first MAX_VOTERS nodes (by name) auto-join as voters. Further
    # nodes are not auto-joined yet (non-voter join is a v0.2 item).
    my @voters = grep { defined } @$nodes[0 .. $MAX_VOTERS - 1];
    my $join = '';
    for my $n (@voters) {
        next if $n->{name} eq $self;
        $join .= "  retry_join {\n    leader_api_addr = \"https://$n->{ip}:$PORT\"\n"
            . "    leader_ca_cert_file = \"$TLS/ca.pem\"\n  }\n";
    }
    my $base = <<"EOF";
# Managed by pve-secrets converge; local edits are overwritten.
ui = true
api_addr = "https://$ip:$PORT"
cluster_addr = "https://$ip:@{[ $PORT + 1 ]}"
disable_mlock = true

listener "tcp" {
  address = "0.0.0.0:$PORT"
  cluster_address = "0.0.0.0:@{[ $PORT + 1 ]}"
  # break-glass: a root token from 3 recovery keys (pve-secrets recover-admin)
  disable_unauthed_generate_root_endpoints = false
  tls_cert_file = "$TLS/node.pem"
  tls_key_file = "$TLS/node.key"
}

seal "static" {
  current_key_id = "pve-1"
  current_key = "file:///run/credentials/openbao.service/seal.key"
}

audit "file" "file" {
  options {
    file_path = "$AUDIT/audit.log"
    mode = "0600"
  }
}
EOF
    my $storage = "\nstorage \"raft\" {\n  path = \"$RAFT\"\n  node_id = \"$self\"\n"
        . "JOIN}\n";
    my $stable = $base . $storage;
    (my $full = $stable) =~ s/JOIN/$join/;
    $stable =~ s/JOIN//;
    return ($full, sha256_hex($stable));
}

sub keepalived_conf {
    my ($cfg, $self) = @_;
    my $pass = substr(sha256_hex(read_file($SEAL) // ''), 0, 8);
    return <<"EOF";
# Managed by pve-secrets converge.
global_defs {
    router_id pve_secrets_$self
    enable_script_security
    script_user root
}
vrrp_script chk_openbao {
    script "/usr/lib/pve-secrets/health"
    interval 2
    fall 2
    rise 2
}
vrrp_instance VI_PVE_SECRETS {
    state BACKUP
    interface $cfg->{interface}
    virtual_router_id $cfg->{vrid}
    priority 100
    advert_int 1
    authentication {
        auth_type PASS
        auth_pass $pass
    }
    virtual_ipaddress {
        $cfg->{vip}
    }
    track_script {
        chk_openbao
    }
}
EOF
}

sub systemctl { run('systemctl', @_) }

sub converge {
    my $cfg = load_cfg() // return 0;    # not initialised: nothing to do
    fail("missing $SEAL") if !-f $SEAL;
    my ($self, $nodes) = members();
    my ($me) = grep { $_->{name} eq $self } @$nodes;
    fail("no IP for node $self") if !$me || !$me->{ip};
    # During a restore only the restoring node runs OpenBao; the others join
    # the restored store afterwards instead of the temporary bootstrap one.
    my $restorer = read_file($RESTORING);
    if (defined $restorer && $restorer =~ /^(\S+)/ && $1 ne $self) {
        systemctl('stop', 'openbao') if !systemctl('is-active', '--quiet', 'openbao');
        return 0;
    }
    (my $vip = $cfg->{vip}) =~ s{/.*}{};

    for my $d ($ETC, $RAFT, $AUDIT) { make_path($d) if !-d $d }
    my (undef, undef, $uid, $gid) = getpwnam('openbao');
    fail('user openbao missing (install openbao)') if !defined $uid;
    chown($uid, $gid, $RAFT, $AUDIT);
    chmod(0700, $RAFT, $AUDIT);

    my @sans = ($self, $me->{ip}, $vip, '127.0.0.1');
    push @sans, $cfg->{name} if $cfg->{name};
    my $cert = ensure_cert(\@sans);
    # openbao cannot read /etc/pve: keep a copy of the cluster CA.
    write_if_changed("$TLS/ca.pem", read_file($CA), 0644, 'openbao');

    my ($text, $hash) = hcl($self, $nodes, $cfg);
    my $hfile = "$ETC/.pve-secrets.hash";
    my $restart = (read_file($hfile) // '') ne $hash;
    write_if_changed($HCL, $text, 0640, 'openbao');
    my (undef, undef, undef, $g) = getpwnam('openbao');
    chown(0, $g, $HCL);
    write_if_changed($hfile, $hash, 0600);

    if (systemctl('is-enabled', '--quiet', 'openbao')) {
        systemctl('enable', '--quiet', 'openbao');
    }
    if (systemctl('is-active', '--quiet', 'openbao')) {
        logmsg('starting openbao');
        systemctl('reset-failed', 'openbao');
        systemctl('start', 'openbao');
    } elsif ($restart) {
        logmsg('config changed, restarting openbao');
        systemctl('restart', 'openbao');
    } elsif ($cert) {
        systemctl('reload', 'openbao');
    }

    make_path('/etc/pve-secrets');
    if (write_if_changed($KA, keepalived_conf($cfg, $self), 0600)) {
        logmsg('keepalived config updated');
        systemctl('enable', '--quiet', 'pve-secrets-vip');
        systemctl('restart', 'pve-secrets-vip');
    } elsif (systemctl('is-active', '--quiet', 'pve-secrets-vip')) {
        systemctl('enable', '--quiet', 'pve-secrets-vip');
        systemctl('start', 'pve-secrets-vip');
    }

    # Relying-party registration in pve-identity (if installed).
    if (-d '/etc/pve/identity/audiences.d' && !-f $AUD_FILE) {
        write_if_changed($AUD_FILE,
            $json->encode({ audience => 'openbao', product => 'pve-secrets' }));
    }

    renew_admin_token();
    ensure_guest_auth();
    ensure_k8s_auth();
    return 0;
}

# ---------------------------------------------------------------- guests
#
# Guests log in at auth/pve with their pve-identity token (aud=openbao) to the
# single role "guest". Keys come from the issuer file (no runtime dependency on
# the issuer host); rotation is picked up here, the next key being published
# minutes before it signs. One templated policy gives each guest:
#   secret/pool/<pool>/*         read   (every guest of the pool)
#   secret/guest/<vmid>-<gen>/*  read   (this guest incarnation only: a clone or
#                                        a re-created VMID has another gen)

sub pubkeys_from_issuer {
    my $d = eval { decode_json(read_file($ISSUER) // '') } // return ();
    my @pem;
    for my $k (@{ $d->{jwks}{keys} // [] }) {
        my $der = $k->{x5c}[0] // next;
        my $cert = "-----BEGIN CERTIFICATE-----\n"
            . join("\n", unpack('(A64)*', $der)) . "\n-----END CERTIFICATE-----\n";
        my $tmp = tempdir(CLEANUP => 1);
        write_if_changed("$tmp/c.pem", $cert, 0600);
        my ($rc, $out) = run('openssl', 'x509', '-in', "$tmp/c.pem", '-noout', '-pubkey');
        push @pem, $out =~ s/\s+$//r if !$rc && $out =~ /BEGIN PUBLIC KEY/;
    }
    return ($d, sort @pem);
}

sub same_set { join("\0", sort @{ $_[0] // [] }) eq join("\0", sort @{ $_[1] // [] }) }

sub ensure_guest_auth {
    return if !-f $ISSUER || !-f $ADMIN;
    my ($hc, $h) = api('GET', 'sys/health', undef, '');
    return if $hc != 200;    # active node only
    my ($iss, @keys) = pubkeys_from_issuer();
    return if !$iss || !@keys;

    my ($c, $auth) = api('GET', 'sys/auth');
    return if $c != 200;
    if (!$auth->{data}{'pve/'}) {
        api('POST', 'sys/auth/pve', { type => 'jwt',
            description => 'Proxmox guests (pve-identity tokens)' });
        logmsg('enabled jwt auth at pve/');
        ($c, $auth) = api('GET', 'sys/auth');
    }
    my $acc = $auth->{data}{'pve/'}{accessor} // return;

    my ($cc, $cfg) = api('GET', 'auth/pve/config');
    my $cur = $cc == 200 ? $cfg->{data} : {};
    if (!same_set($cur->{jwt_validation_pubkeys}, \@keys)
        || ($cur->{bound_issuer} // '') ne $iss->{issuer}) {
        my ($wc, $wd) = api('POST', 'auth/pve/config',
            { jwt_validation_pubkeys => \@keys, bound_issuer => $iss->{issuer} });
        $wc =~ /^2/ ? logmsg('guest auth keys updated (' . scalar(@keys) . ')')
            : logmsg("guest auth config failed ($wc): " . encode_json($wd));
    }

    my ($mc, $mounts) = api('GET', 'sys/mounts');
    if ($mc == 200 && !$mounts->{data}{'secret/'}) {
        api('POST', 'sys/mounts/secret', { type => 'kv', options => { version => '2' },
            description => 'pve-secrets: pool/<pool>/ and guest/<vmid>-<gen>/' });
        logmsg('enabled kv-v2 at secret/');
    }

    my $m = "identity.entity.aliases.$acc.metadata";
    my $policy = <<"EOF";
# Managed by pve-secrets converge.
path "secret/data/pool/{{$m.pool}}/*" { capabilities = ["read"] }
path "secret/metadata/pool/{{$m.pool}}/*" { capabilities = ["read", "list"] }
path "secret/data/guest/{{$m.vmid}}-{{$m.gen}}/*" { capabilities = ["read"] }
path "secret/metadata/guest/{{$m.vmid}}-{{$m.gen}}/*" { capabilities = ["read", "list"] }
EOF
    my ($pc, $pd) = api('GET', 'sys/policies/acl/pve-guest');
    if ($pc != 200 || ($pd->{data}{policy} // '') ne $policy) {
        api('PUT', 'sys/policies/acl/pve-guest', { policy => $policy });
        logmsg('guest policy updated');
    }

    my $role = {
        role_type => 'jwt', user_claim => 'sub', bound_audiences => ['openbao'],
        claim_mappings => { '/pve/pool' => 'pool', '/pve/vmid' => 'vmid',
            '/pve/gen' => 'gen', '/pve/kind' => 'kind', '/pve/cluster' => 'cluster' },
        token_policies => ['pve-guest'], token_ttl => 3600, token_max_ttl => 3600,
        token_type => 'service',
    };
    my ($rc2, $rd) = api('GET', 'auth/pve/role/guest');
    my $r = $rc2 == 200 ? $rd->{data} : {};
    my $same = $rc2 == 200 && same_set($r->{token_policies}, $role->{token_policies})
        && same_set($r->{bound_audiences}, $role->{bound_audiences})
        && ($r->{user_claim} // '') eq 'sub'
        && encode_json([ map { "$_=" . ($r->{claim_mappings}{$_} // '') } sort keys %{ $role->{claim_mappings} } ])
           eq encode_json([ map { "$_=$role->{claim_mappings}{$_}" } sort keys %{ $role->{claim_mappings} } ])
        && ($r->{token_ttl} // 0) == 3600;
    if (!$same) {
        my ($wc, $wd) = api('POST', 'auth/pve/role/guest', $role);
        $wc =~ /^2/ ? logmsg('guest role updated')
            : logmsg("guest role failed ($wc): " . encode_json($wd));
    }
}

# ---------------------------------------------------------------- API

sub api {
    my ($method, $path, $body, $token) = @_;
    $token //= do { my $t = read_file($ADMIN); chomp $t if defined $t; $t };
    my @cmd = ('curl', '-sS', '--cacert', $CA, '-X', $method, '-w', '\n%{http_code}',
        "https://127.0.0.1:$PORT/v1/$path");
    push @cmd, '-H', "X-Vault-Token: $token" if $token;
    push @cmd, '-H', 'Content-Type: application/json', '--data-binary',
        encode_json($body) if $body;
    my (undef, $out) = run(@cmd);
    my ($data, $code) = $out =~ /\A(.*)\n(\d+)\z/s ? ($1, $2) : ($out, 0);
    my $d = eval { decode_json($data) } // { raw => $data };
    return ($code, $d);
}

sub renew_admin_token {
    return if !-f $ADMIN;
    my ($c, $d) = api('GET', 'auth/token/lookup-self');
    return if $c != 200;
    my $ttl = $d->{data}{ttl} // 0;
    api('POST', 'auth/token/renew-self', {}) if $ttl < 12 * 3600;
}

sub wait_up {
    for (1 .. 60) {
        my ($c) = api('GET', 'sys/health?uninitcode=200&sealedcode=200&standbyok=true', undef, '');
        return 1 if $c == 200;
        sleep 1;
    }
    return 0;
}

sub write_cfg {
    my ($o) = @_;
    write_if_changed($CFG, "# pve-secrets cluster settings\n"
        . join('', map { "$_: $o->{$_}\n" } grep { defined $o->{$_} } @CFG_KEYS));
}

# pve-admin policy + periodic orphan admin token for the PVE side; older
# admin tokens (e.g. brought back by a restore) are revoked.
sub mint_admin {
    my ($root) = @_;
    api('PUT', 'sys/policies/acl/pve-admin',
        { policy => qq{path "*" { capabilities = ["create","read","update","delete","list","sudo"] }\n} },
        $root);
    my ($tc, $td) = api('POST', 'auth/token/create-orphan',
        { policies => ['pve-admin'], period => '72h', display_name => 'pve-secrets-admin',
          no_default_policy => JSON::PP::true }, $root);
    fail("admin token ($tc)") if $tc != 200;
    my $new = $td->{auth}{accessor};
    my ($lc, $ld) = api('LIST', 'auth/token/accessors', undef, $root);
    for my $acc ($lc == 200 ? @{ $ld->{data}{keys} // [] } : ()) {
        next if $acc eq $new;
        my ($c, $d) = api('POST', 'auth/token/lookup-accessor', { accessor => $acc }, $root);
        next if $c != 200 || ($d->{data}{display_name} // '') ne 'token-pve-secrets-admin';
        api('POST', 'auth/token/revoke-accessor', { accessor => $acc }, $root);
        logmsg('revoked an older admin token');
    }
    write_if_changed($ADMIN, $td->{auth}{client_token} . "\n", 0600);
    api('PUT', 'sys/storage/raft/autopilot/configuration',
        { cleanup_dead_servers => JSON::PP::false }, $root);
}

sub cmd_init {
    my @a = @_;
    my %o = (interface => 'vmbr0', vrid => 90);
    GetOptionsFromArray(\@a, \%o, 'vip=s', 'name=s', 'interface=s', 'vrid=i', 'json')
        or fail('bad options');
    fail('--vip IP/CIDR is required') if !$o{vip} || $o{vip} !~ m{^[\d.]+/\d+$};
    fail("already initialised ($CFG exists)") if -f $CFG;
    make_path($PRIV, { mode => 0700 });
    if (!-f $SEAL) {
        my ($rc, $out) = run('openssl', 'rand', '-out', $SEAL, 32);
        fail("seal key: $out") if $rc;
    }
    fail("--interface: no such interface $o{interface}") if !-d "/sys/class/net/$o{interface}";
    write_cfg(\%o);
    converge();
    wait_up() or fail('openbao did not come up');

    my ($c, $d) = api('PUT', 'sys/init', { recovery_shares => 5, recovery_threshold => 3 }, '');
    fail("init failed ($c): " . encode_json($d)) if $c != 200;
    my $root = $d->{root_token};
    my $keys = $d->{recovery_keys_base64} // [];
    if (@$keys != 5) {    # never lose the keys: keep the raw answer
        write_if_changed('/root/pve-secrets-init.json', encode_json($d), 0600);
        fail('unexpected init answer saved to /root/pve-secrets-init.json');
    }
    sleep 2;
    mint_admin($root);
    api('POST', 'auth/token/revoke-self', {}, $root);

    if ($o{json}) {    # API: keys go back to the caller only
        print encode_json({ recovery_keys => $keys, threshold => 3 }), "\n";
        return 0;
    }
    print "pve-secrets initialised. Store these recovery keys OFFLINE now;\n"
        . "they are not saved anywhere (any 3 of 5 regenerate a root token):\n\n";
    print "  $_\n" for @$keys;
    print "\nThe other nodes join within a minute (pve-secrets-converge.timer).\n";
    return 0;
}

sub status_data {
    my $cfg = load_cfg() // return { initialised => JSON::PP::false };
    my ($c, $h) = api('GET', 'sys/health?standbyok=true&sealedcode=200&uninitcode=200', undef, '');
    my $local = $c == 0 ? 'down'
        : $h->{sealed} ? 'sealed' : $h->{standby} ? 'standby' : 'active';
    my ($ac, $ap) = api('GET', 'sys/storage/raft/autopilot/state');
    my $s = $ac == 200 ? ($ap->{data} // $ap) : {};
    my @servers = map {
        my $v = $s->{servers}{$_};
        { node => $_, status => $v->{status}, voter => ($v->{node_type} // '') eq 'voter' ? 1 : 0,
          healthy => $v->{healthy} ? 1 : 0, address => $v->{address} }
    } sort keys %{ $s->{servers} // {} };
    return {
        initialised => JSON::PP::true, vip => $cfg->{vip}, name => $cfg->{name},
        local => $local, version => $h->{version},
        available => $ac == 200 ? 1 : 0, healthy => $s->{healthy} ? 1 : 0,
        leader => $s->{leader}, failure_tolerance => $s->{failure_tolerance} // 0,
        servers => \@servers,
        backup => backup_info($cfg),
    };
}

sub cmd_status {
    if (grep { $_ eq '--json' } @_) {
        print encode_json(status_data()), "\n";
        return 0;
    }
    my $cfg = load_cfg();
    if (!$cfg) { print "not initialised\n"; return 0 }
    my ($c, $h) = api('GET', 'sys/health?standbyok=true&sealedcode=200&uninitcode=200', undef, '');
    printf "local: %s\n", $c == 0 ? 'down'
        : ($h->{sealed} ? 'sealed' : $h->{standby} ? 'standby' : 'active') . " ($h->{version})";
    my ($ac, $ap) = api('GET', 'sys/storage/raft/autopilot/state');
    if ($ac != 200) { print "cluster: unavailable ($ac)\n"; return 1 }
    my $s = $ap->{data} // $ap;
    my $tol = $s->{failure_tolerance} // 0;
    printf "cluster: %s, leader %s, failure tolerance %d%s\n",
        $s->{healthy} ? 'healthy' : 'UNHEALTHY', $s->{leader} // '?', $tol,
        $tol == 0 ? '  WARNING: losing any node stops the store' : '';
    for my $id (sort keys %{ $s->{servers} // {} }) {
        my $v = $s->{servers}{$id};
        printf "  %-12s %-9s %-8s %s\n", $id, $v->{status}, $v->{node_type} // '',
            $v->{healthy} ? 'healthy' : 'unhealthy';
    }
    printf "vip: %s\n", $cfg->{vip};
    return $s->{healthy} ? 0 : 1;
}


# ---------------------------------------------------------------- backup
#
# Raft snapshots go to <backup dir of a PVE storage>/pve-secrets/. They are
# encrypted by the store's keyring, which the seal key protects: a snapshot
# alone reveals nothing, and a restore on a rebuilt cluster needs the seal
# key (pve-secrets export-seal-key) and the recovery keys.

sub backup_dir {
    my ($cfg) = @_;
    my $id = $cfg->{backup_storage} // return undef;
    require PVE::Storage;
    my $sc = PVE::Storage::config();
    my $scfg = PVE::Storage::storage_config($sc, $id);
    die "storage '$id' does not allow backup content\n" if !$scfg->{content}{backup};
    PVE::Storage::activate_storage($sc, $id);
    return PVE::Storage::get_backup_dir($sc, $id) . '/pve-secrets';
}

sub snapshots {
    my ($dir) = @_;
    # oldest first, by time (names carry the cluster name, which may change)
    return map { $_->[1] } sort { $a->[0] <=> $b->[0] || $a->[1] cmp $b->[1] }
        map { [(stat $_)[9] // 0, $_] } glob("$dir/pve-secrets-*.snap");
}

sub file_sha256 {
    my ($f) = @_;
    my $d = Digest::SHA->new(256);
    $d->addfile($f) or return '';
    return $d->hexdigest;
}

# Returns undef when the snapshot is sound, else the reason.
sub check_snapshot {
    my ($f) = @_;
    my $side = read_file("$f.sha256");
    if (defined $side) {
        my ($want) = $side =~ /^([0-9a-f]{64})/;
        return 'file checksum mismatch' if !$want || $want ne file_sha256($f);
    }
    my $tmp = tempdir(CLEANUP => 1);
    my ($rc) = run('tar', '-xzf', $f, '-C', $tmp);
    return 'not a readable snapshot archive' if $rc;
    my $sums = read_file("$tmp/SHA256SUMS") // return 'SHA256SUMS missing';
    my %seen;
    for (split /\n/, $sums) {
        my ($h, $n) = /^([0-9a-f]{64})\s+(\S+)$/ or return 'SHA256SUMS malformed';
        return "$n missing" if !-f "$tmp/$n";
        return "$n checksum mismatch" if file_sha256("$tmp/$n") ne $h;
        $seen{$n} = 1;
    }
    return 'state.bin not covered' if !$seen{'state.bin'};
    return undef;
}

sub backup_info {
    my ($cfg) = @_;
    return { configured => JSON::PP::false } if !$cfg->{backup_storage};
    my %i = (configured => JSON::PP::true, storage => $cfg->{backup_storage},
        keep => $cfg->{backup_keep} // 14, interval => $cfg->{backup_interval} // 24);
    my $dir = eval { backup_dir($cfg) };
    if (!$dir) { $i{error} = ($@ // '') =~ s/\s+$//r; return \%i }
    my @s = snapshots($dir);
    $i{count} = scalar @s;
    if (@s) {
        $i{last} = (stat $s[-1])[9];
        ($i{last_file} = $s[-1]) =~ s{.*/}{};
    }
    return \%i;
}

sub cmd_backup_config {
    my @a = @_;
    my %o;
    GetOptionsFromArray(\@a, \%o, 'storage=s', 'keep=i', 'interval=i') or fail('bad options');
    my $cfg = load_cfg() // fail('not initialised');
    $cfg->{backup_storage} = $o{storage} if defined $o{storage};
    $cfg->{backup_keep} = $o{keep} if defined $o{keep};
    $cfg->{backup_interval} = $o{interval} if defined $o{interval};
    fail('--keep must be 1..1000') if defined $o{keep} && ($o{keep} < 1 || $o{keep} > 1000);
    fail('--interval must be 1..720 hours') if defined $o{interval} && ($o{interval} < 1 || $o{interval} > 720);
    my $dir = eval { backup_dir($cfg) } // fail(($@ || 'no --storage') =~ s/\s+$//r);
    write_cfg($cfg);
    logmsg("backups go to $dir");
    return 0;
}

sub cmd_backup {
    my @a = @_;
    my %o;
    GetOptionsFromArray(\@a, \%o, 'force') or fail('bad options');
    my $cfg = load_cfg() // return 0;
    if (!$cfg->{backup_storage}) {
        return 0 if !$o{force};
        fail('no backup storage set (pve-secrets backup-config --storage ID)');
    }
    my ($hc, $h) = api('GET', 'sys/health?standbyok=true', undef, '');
    if (!$o{force} && ($hc != 200 || $h->{standby})) {
        return 0;    # the active node does the scheduled backup
    }
    my $dir = eval { backup_dir($cfg) } // fail(($@ // '') =~ s/\s+$//r);
    make_path($dir, { mode => 0700 });
    my @s = snapshots($dir);
    my $interval = ($cfg->{backup_interval} // 24) * 3600;
    if (!$o{force} && @s && time - (stat $s[-1])[9] < $interval - 300) {
        return 0;
    }
    PVE::Cluster::cfs_update();
    my $cl = lc(eval { PVE::Cluster::get_clinfo()->{cluster}{name} } // 'pve');
    my @t = gmtime;
    my $name = sprintf('pve-secrets-%s-%04d%02d%02d-%02d%02d%02d.snap', $cl,
        $t[5] + 1900, $t[4] + 1, @t[3, 2, 1, 0]);
    my $tmp = "$dir/.$name.part";
    my $token = read_file($ADMIN) // fail("missing $ADMIN");
    chomp $token;
    my ($rc, $out) = run('curl', '-sS', '-f', '--cacert', $CA, '-H', "X-Vault-Token: $token",
        '-o', $tmp, "https://127.0.0.1:$PORT/v1/sys/storage/raft/snapshot");
    if ($rc) { unlink $tmp; fail("snapshot failed: $out") }
    chmod(0600, $tmp);
    if (my $err = check_snapshot($tmp)) { unlink $tmp; fail("snapshot unusable: $err") }
    my $sum = file_sha256($tmp);
    write_if_changed("$dir/$name.sha256", "$sum  $name\n", 0600);
    rename($tmp, "$dir/$name") or fail("rename: $!");
    logmsg("snapshot $dir/$name (" . (-s "$dir/$name") . ' bytes)');
    @s = snapshots($dir);
    my $keep = $cfg->{backup_keep} // 14;
    while (@s > $keep) {
        my $old = shift @s;
        unlink($old, "$old.sha256");
        logmsg("pruned $old");
    }
    return 0;
}

sub cmd_backup_check {
    my $as_json = grep { $_ eq '--json' } @_;
    my $cfg = load_cfg() // fail('not initialised');
    my $dir = eval { backup_dir($cfg) } // fail(($@ || 'no backup storage set') =~ s/\s+$//r);
    my (@r, $bad);
    for my $f (snapshots($dir)) {
        my $err = check_snapshot($f);
        $bad++ if $err;
        (my $n = $f) =~ s{.*/}{};
        push @r, { file => $n, ok => $err ? JSON::PP::false : JSON::PP::true, error => $err };
    }
    if ($as_json) {
        print encode_json(\@r), "\n";
    } else {
        printf "%-8s %s%s\n", $_->{ok} ? 'OK' : 'CORRUPT', $_->{file},
            $_->{error} ? "  ($_->{error})" : '' for @r;
        print "no snapshots in $dir\n" if !@r;
    }
    return $bad ? 1 : 0;
}

sub cmd_export_seal_key {
    my $k = read_file($SEAL) // fail("missing $SEAL");
    print "# pve-secrets seal key (base64). Needed with the recovery keys to\n"
        . "# restore a snapshot on a rebuilt cluster. Keep it OFFLINE.\n"
        . encode_base64($k, '') . "\n";
    return 0;
}

# ---------------------------------------------------------------- recovery

sub read_recovery_keys {
    my @k = grep { length } map { s/^\s+|\s+$//gr } grep { !/^\s*#/ } <STDIN>;
    fail('give 3 recovery keys on stdin, one per line') if @k < 3;
    return @k;
}

# Root token from recovery keys (generate-root with a one-time pad), used
# only to mint a new admin token and then revoked.
sub root_from_recovery {
    my (@keys) = @_;
    api('DELETE', 'sys/generate-root/attempt', undef, '');
    my ($c, $d) = api('PUT', 'sys/generate-root/attempt', {}, '');
    fail("generate-root start ($c): " . encode_json($d)) if $c != 200;
    my ($nonce, $otp) = ($d->{nonce}, $d->{otp});
    my $enc;
    for my $k (@keys) {
        ($c, $d) = api('PUT', 'sys/generate-root/update', { key => $k, nonce => $nonce }, '');
        if ($c != 200) {
            api('DELETE', 'sys/generate-root/attempt', undef, '');
            fail('recovery key refused: ' . join('; ', @{ $d->{errors} // [] }));
        }
        $enc = $d->{encoded_token} || $d->{encoded_root_token};
        last if $d->{complete};
    }
    fail('not enough valid recovery keys') if !$enc;
    $enc .= '=' x ((4 - length($enc) % 4) % 4);
    return decode_base64($enc) ^ $otp;
}

sub cmd_recover_admin {
    load_cfg() // fail('not initialised');
    my $root = root_from_recovery(read_recovery_keys());
    mint_admin($root);
    api('POST', 'auth/token/revoke-self', {}, $root);
    logmsg('new admin token written');
    return 0;
}

sub wait_active {    # unsealed and a leader elected (this node or another)
    for (1 .. 90) {
        my ($c, $h) = api('GET', 'sys/health?standbyok=true', undef, '');
        return 1 if $c == 200 && !$h->{sealed};
        sleep 1;
    }
    return 0;
}

sub force_restore {
    my ($file, $token) = @_;
    my ($rc, $out) = run('curl', '-sS', '--cacert', $CA, '-H', "X-Vault-Token: $token",
        '-X', 'POST', '--data-binary', "\@$file", '-w', '\n%{http_code}',
        "https://127.0.0.1:$PORT/v1/sys/storage/raft/snapshot-force");
    my ($code) = $out =~ /(\d+)\s*\z/;
    fail("restore refused: $out") if $rc || !$code || $code !~ /^2/;
}

# The PVE storage whose backup directory holds $file, if any.
sub storage_of {
    my ($file) = @_;
    require Cwd;
    my $abs = Cwd::abs_path($file) // return undef;
    require PVE::Storage;
    my $sc = PVE::Storage::config();
    for my $id (sort keys %{ $sc->{ids} }) {
        next if !$sc->{ids}{$id}{content}{backup};
        my $d = eval { Cwd::abs_path(PVE::Storage::get_backup_dir($sc, $id)) } // next;
        return $id if index($abs, "$d/") == 0;
    }
    return undef;
}

sub cmd_restore {
    my @a = @_;
    my %o = (interface => 'vmbr0', vrid => 90);
    GetOptionsFromArray(\@a, \%o, 'seal-key=s', 'vip=s', 'name=s', 'interface=s', 'vrid=i')
        or fail('bad options');
    my $file = shift @a // fail('usage: pve-secrets restore SNAPSHOT [options] < recovery-keys');
    fail("$file: no such file") if !-f $file;
    if (my $err = check_snapshot($file)) { fail("$file: $err") }
    my @keys = read_recovery_keys();

    if (-f $CFG) {    # in place: same store, roll back to the snapshot
        fail('--seal-key is only for a rebuilt cluster') if $o{'seal-key'};
        my $token = read_file($ADMIN) // fail("missing $ADMIN");
        chomp $token;
        force_restore($file, $token);
    } else {          # rebuilt cluster: bootstrap with the old seal key
        fail('rebuilt cluster: --seal-key FILE and --vip IP/CIDR are required')
            if !$o{'seal-key'} || !$o{vip} || $o{vip} !~ m{^[\d.]+/\d+$};
        my $raw = read_file($o{'seal-key'}) // fail("$o{'seal-key'}: $!");
        # raw 32 bytes, or the text printed by export-seal-key
        $raw = decode_base64(join '', grep { !/^\s*#/ } split /\n/, $raw) if length($raw) != 32;
        fail('seal key must be 32 bytes') if length($raw) != 32;
        make_path($PRIV, { mode => 0700 });
        write_if_changed($SEAL, $raw, 0600);
        my ($self) = members();
        write_if_changed($RESTORING, "$self\n", 0600);
        my %c = map { $_ => $o{$_} } qw(vip name interface vrid);
        # keep backing up to the storage the snapshot came from
        if (my $sid = storage_of($file)) { $c{backup_storage} = $sid }
        write_cfg(\%c);
        converge();
        wait_up() or fail('openbao did not come up');
        my ($c, $d) = api('PUT', 'sys/init', { recovery_shares => 1, recovery_threshold => 1 }, '');
        fail("bootstrap init failed ($c): " . encode_json($d)) if $c != 200;
        wait_active() or fail('bootstrap store did not unseal');
        force_restore($file, $d->{root_token});
    }
    sleep 3;
    wait_active() or fail('store did not come back after the restore');
    # After an in-place snapshot load the leader cannot stream Raft data to
    # followers until OpenBao restarts ("no client configured for alpn").
    systemctl('restart', 'openbao');
    wait_active() or fail('store did not come back after the restart');
    my $root = root_from_recovery(@keys);
    mint_admin($root);
    api('POST', 'auth/token/revoke-self', {}, $root);
    if (-f $RESTORING) {
        unlink $RESTORING;
        logmsg('the other nodes join the restored store within a minute;'
            . ' a node with data from before must be emptied first'
            . ' (systemctl stop openbao; rm -rf /var/lib/openbao/raft)');
    }
    logmsg("restored $file; new admin token written");
    return 0;
}

# ---------------------------------------------------------------- kubernetes
#
# One jwt mount per registered cluster, auth/k8s-<cluster>, trusting that
# cluster's service-account issuer keys (pushed by pve-k8s on create/rotate).
# Role "workload": tokens with aud=openbao; policy k8s-<cluster> gives read on
#   secret/k8s/<cluster>/<namespace>/*   (the namespace from the token)

sub der_len {
    my ($n) = @_;
    return chr($n) if $n < 128;
    my $b = '';
    while ($n) { $b = chr($n & 255) . $b; $n >>= 8 }
    return chr(128 | length $b) . $b;
}
sub der { my ($tag, $body) = @_; return chr($tag) . der_len(length $body) . $body }
sub der_uint { my ($b) = @_; $b =~ s/^\0+//; $b = "\0$b" if ord(substr($b, 0, 1)) & 128; der(0x02, $b) }
sub b64url { my ($s) = @_; $s =~ tr{-_}{+/}; $s .= '=' x ((4 - length($s) % 4) % 4); decode_base64($s) }

# JWK (RSA or EC P-256) -> PEM public key.
sub jwk_pem {
    my ($k) = @_;
    my $spki;
    if (($k->{kty} // '') eq 'RSA' && $k->{n} && $k->{e}) {
        my $alg = der(0x30, der(0x06, "\x2a\x86\x48\x86\xf7\x0d\x01\x01\x01") . der(0x05, ''));
        my $key = der(0x30, der_uint(b64url($k->{n})) . der_uint(b64url($k->{e})));
        $spki = der(0x30, $alg . der(0x03, "\0" . $key));
    } elsif (($k->{kty} // '') eq 'EC' && ($k->{crv} // '') eq 'P-256' && $k->{x} && $k->{y}) {
        my $alg = der(0x30, der(0x06, "\x2a\x86\x48\xce\x3d\x02\x01")
            . der(0x06, "\x2a\x86\x48\xce\x3d\x03\x01\x07"));
        $spki = der(0x30, $alg . der(0x03, "\0\x04" . b64url($k->{x}) . b64url($k->{y})));
    } else {
        return undef;
    }
    return "-----BEGIN PUBLIC KEY-----\n" . join("\n", unpack('(A64)*', encode_base64($spki, '')))
        . "\n-----END PUBLIC KEY-----";
}

# JWKS JSON text or concatenated PEM keys -> list of PEM keys.
sub keys_from_text {
    my ($t) = @_;
    my @pem = $t =~ /(-----BEGIN PUBLIC KEY-----.*?-----END PUBLIC KEY-----)/sg;
    return @pem if @pem;
    my $j = eval { decode_json($t) } // return ();
    return grep { defined } map { jwk_pem($_) } @{ $j->{keys} // [] };
}

sub k8s_clusters {
    my %c;
    for my $f (glob("$K8S_DIR/*.json")) {
        my ($name) = $f =~ m{/([a-z0-9][a-z0-9-]{0,39})\.json$} or next;
        my $d = eval { decode_json(read_file($f)) } or next;
        $c{$name} = $d;
    }
    return \%c;
}

sub ensure_k8s_auth {
    return if !-f $ADMIN;
    my ($hc) = api('GET', 'sys/health', undef, '');
    return if $hc != 200;    # active node only
    my $want = k8s_clusters();
    my ($c, $auth) = api('GET', 'sys/auth');
    return if $c != 200;
    my %have = map { m{^k8s-(.+)/$} ? ($1 => 1) : () } keys %{ $auth->{data} // {} };

    for my $cl (sort keys %$want) {
        my $d = $want->{$cl};
        my @keys = sort map { s/\s+$//r } @{ $d->{keys} // [] };
        next if !@keys || !$d->{issuer};
        my $mount = "k8s-$cl";
        if (!$have{$cl}) {
            api('POST', "sys/auth/$mount", { type => 'jwt',
                description => "Kubernetes cluster $cl (service-account tokens)" });
            logmsg("enabled jwt auth at $mount/");
            ($c, $auth) = api('GET', 'sys/auth');
        }
        my $acc = $auth->{data}{"$mount/"}{accessor} // next;
        my ($cc, $cfg) = api('GET', "auth/$mount/config");
        my $cur = $cc == 200 ? $cfg->{data} : {};
        if (!same_set($cur->{jwt_validation_pubkeys}, \@keys)
            || ($cur->{bound_issuer} // '') ne $d->{issuer}) {
            my ($wc, $wd) = api('POST', "auth/$mount/config",
                { jwt_validation_pubkeys => \@keys, bound_issuer => $d->{issuer} });
            $wc =~ /^2/ ? logmsg("$mount: issuer keys updated (" . scalar(@keys) . ')')
                : logmsg("$mount: config failed ($wc): " . encode_json($wd));
        }
        my $m = "identity.entity.aliases.$acc.metadata";
        my $policy = <<"EOF";
# Managed by pve-secrets converge (Kubernetes cluster $cl).
path "secret/data/k8s/$cl/{{$m.namespace}}/*" { capabilities = ["read"] }
path "secret/metadata/k8s/$cl/{{$m.namespace}}/*" { capabilities = ["read", "list"] }
EOF
        my ($pc, $pd) = api('GET', "sys/policies/acl/$mount");
        if ($pc != 200 || ($pd->{data}{policy} // '') ne $policy) {
            api('PUT', "sys/policies/acl/$mount", { policy => $policy });
            logmsg("$mount: policy updated");
        }
        my $role = {
            role_type => 'jwt', user_claim => 'sub', bound_audiences => ['openbao'],
            claim_mappings => { '/kubernetes.io/namespace' => 'namespace',
                '/kubernetes.io/serviceaccount/name' => 'serviceaccount' },
            token_policies => [$mount], token_ttl => 3600, token_max_ttl => 3600,
        };
        my ($rc2, $rd) = api('GET', "auth/$mount/role/workload");
        my $r = $rc2 == 200 ? $rd->{data} : {};
        my $same = $rc2 == 200 && same_set($r->{token_policies}, [$mount])
            && same_set($r->{bound_audiences}, ['openbao'])
            && ($r->{claim_mappings}{'/kubernetes.io/namespace'} // '') eq 'namespace'
            && ($r->{token_ttl} // 0) == 3600;
        if (!$same) {
            my ($wc, $wd) = api('POST', "auth/$mount/role/workload", $role);
            $wc =~ /^2/ ? logmsg("$mount: role updated")
                : logmsg("$mount: role failed ($wc): " . encode_json($wd));
        }
    }
    for my $cl (sort keys %have) {    # unregistered: remove mount and policy
        next if $want->{$cl};
        api('DELETE', "sys/auth/k8s-$cl");
        api('DELETE', "sys/policies/acl/k8s-$cl");
        logmsg("k8s-$cl: removed (cluster unregistered)");
    }
}

sub cmd_k8s_register {
    my @a = @_;
    my %o;
    GetOptionsFromArray(\@a, \%o, 'cluster=s', 'issuer=s', 'jwks=s') or fail('bad options');
    fail('--cluster NAME (a-z, 0-9, -; max 40)') if ($o{cluster} // '') !~ /^[a-z0-9][a-z0-9-]{0,39}$/;
    fail('--issuer https://...') if ($o{issuer} // '') !~ m{^https://\S+$};
    my $txt = $o{jwks} eq '-' ? do { local $/; <STDIN> } : read_file($o{jwks} // '');
    fail('--jwks FILE (JWKS JSON or PEM public keys; - for stdin)') if !defined $txt;
    my @keys = keys_from_text($txt);
    fail('no usable public key (RSA or EC P-256)') if !@keys;
    load_cfg() // fail('not initialised');
    make_path($K8S_DIR);
    write_if_changed("$K8S_DIR/$o{cluster}.json", $json->encode({ cluster => $o{cluster},
        issuer => $o{issuer}, keys => \@keys, updated => time }));
    ensure_k8s_auth();
    logmsg("cluster $o{cluster}: " . scalar(@keys) . ' key(s); pods read'
        . " secret/k8s/$o{cluster}/<namespace>/* via auth/k8s-$o{cluster} role workload (aud openbao)");
    return 0;
}

sub cmd_k8s_unregister {
    my @a = @_;
    my %o;
    GetOptionsFromArray(\@a, \%o, 'cluster=s') or fail('bad options');
    my $f = "$K8S_DIR/" . ($o{cluster} // '') . '.json';
    fail("cluster not registered") if !$o{cluster} || !-f $f;
    unlink $f;
    ensure_k8s_auth();
    return 0;
}

sub k8s_list_data {
    my $c = k8s_clusters();
    return [ map { { cluster => $_, issuer => $c->{$_}{issuer},
        keys => scalar @{ $c->{$_}{keys} // [] }, updated => $c->{$_}{updated} } } sort keys %$c ];
}

sub cmd_k8s_list {
    my $l = k8s_list_data();
    if (grep { $_ eq '--json' } @_) { print encode_json($l), "\n"; return 0 }
    printf "%-20s %-5s %s\n", $_->{cluster}, $_->{keys}, $_->{issuer} for @$l;
    return 0;
}

my $cmd = shift @ARGV // 'help';
exit(
      $cmd eq 'init'     ? cmd_init(@ARGV)
    : $cmd eq 'converge' ? converge()
    : $cmd eq 'status'   ? cmd_status(@ARGV)
    : $cmd eq 'backup-config'   ? cmd_backup_config(@ARGV)
    : $cmd eq 'backup'          ? cmd_backup(@ARGV)
    : $cmd eq 'backup-check'    ? cmd_backup_check(@ARGV)
    : $cmd eq 'export-seal-key' ? cmd_export_seal_key()
    : $cmd eq 'restore'         ? cmd_restore(@ARGV)
    : $cmd eq 'recover-admin'   ? cmd_recover_admin()
    : $cmd eq 'k8s-register'    ? cmd_k8s_register(@ARGV)
    : $cmd eq 'k8s-unregister'  ? cmd_k8s_unregister(@ARGV)
    : $cmd eq 'k8s-list'        ? cmd_k8s_list(@ARGV)
    : do {
        print "usage: pve-secrets init|converge|status|backup-config|backup|backup-check|\n"
            . "       export-seal-key|restore|recover-admin|k8s-register|k8s-unregister|k8s-list\n"
            . "       (see the header of $0)\n";
        $cmd eq 'help' ? 0 : 1 }
);
